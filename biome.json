{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "files": {
        "includes": [
            "src/**",
            "netlify/**",
            "scripts/**",
            "*.json",
            "*.ts"
        ]
    },
    "formatter": {
        "$comment": "Disabled on purpose. The settings below are what this repo actually uses (4-space, 100 columns) so that turning the formatter on formats correctly rather than to biome's tab defaults. Enabling it reformats ~160 of 214 files in one go, so that is a deliberate decision, not a side effect of running a lint fix.",
        "enabled": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noCommentText": "off",
                "noExplicitAny": "warn"
            },
            "complexity": {
                "noImportantStyles": "off"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "noDescendingSpecificity": "off"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
