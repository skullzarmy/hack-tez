{
  "$schema": "https://www.partykit.io/schema.json",
  "name": "hackchat",
  "main": "src/party/global.ts",
  "parties": {
    "dm": "src/party/dm.ts"
  },
  "compatibilityDate": "2026-04-05",
  "bindings": {
    "d1_databases": {
      "DB": {
        "database_name": "hackchat",
        "database_id": "YOUR_D1_DATABASE_ID"
      }
    }
  }
}
