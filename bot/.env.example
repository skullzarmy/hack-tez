# ── Telegram ────────────────────────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user ID of the admin (the only user allowed for now)
TELEGRAM_ADMIN_USER_ID=

# ── Tezos Network ────────────────────────────────────────────────────────────
# "mainnet" | "ghostnet" | "shadownet"
TEZOS_NETWORK=ghostnet

# Deployed HackTezRegistrar contract address
REGISTRAR_ADDRESS=

# ── Polling ──────────────────────────────────────────────────────────────────
# How often to poll TzKT for new events (milliseconds, default: 30000)
POLL_INTERVAL_MS=30000

# ── Storage ───────────────────────────────────────────────────────────────────
# Path to SQLite database file (default: ./data/bot.db)
DB_PATH=./data/bot.db

# Optional: allow starting without bootstrapping cursors (not recommended)
# BOT_ALLOW_COLD_START=1
